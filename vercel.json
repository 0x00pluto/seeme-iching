{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/interpret.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 60
    }
  }
}
