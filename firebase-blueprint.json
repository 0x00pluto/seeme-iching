{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User's display name" },
        "email": { "type": "string", "description": "User's email address" },
        "photoURL": { "type": "string", "description": "User's profile photo URL" },
        "createdAt": { "type": "number", "description": "Timestamp of profile creation" }
      },
      "required": ["uid", "email"]
    },
    "DivinationRecord": {
      "title": "DivinationRecord",
      "description": "A single divination session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique record ID" },
        "uid": { "type": "string", "description": "Owner's UID" },
        "timestamp": { "type": "number", "description": "Time of divination" },
        "question": { "type": "string", "description": "The question asked" },
        "lines": { "type": "array", "items": { "type": "number" }, "description": "Hexagram lines" },
        "interpretation": { "type": "string", "description": "AI generated interpretation" },
        "reflection": { "type": "string", "description": "User's personal reflection" }
      },
      "required": ["id", "uid", "timestamp", "lines"]
    },
    "DialogueSession": {
      "title": "DialogueSession",
      "description": "An 8-round deep dialogue session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "uid": { "type": "string", "description": "Owner's UID" },
        "divinationId": { "type": "string", "description": "Associated divination record ID" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "content": { "type": "string" },
              "timestamp": { "type": "number" }
            }
          }
        },
        "round": { "type": "number", "description": "Current round number (1-8)" },
        "isComplete": { "type": "boolean", "description": "Whether the session is finished" },
        "timestamp": { "type": "number", "description": "Time of session creation/update" }
      },
      "required": ["id", "uid", "divinationId", "messages", "round", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/history/{recordId}": {
      "schema": "DivinationRecord",
      "description": "Divination history records"
    },
    "/dialogues/{sessionId}": {
      "schema": "DialogueSession",
      "description": "Deep dialogue session records"
    }
  }
}
